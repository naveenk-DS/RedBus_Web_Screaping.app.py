import pandas as pd
import mysql.connector

# Load the cleaned CSV
df = pd.read_csv(r"E:/RedBus_Scraper_App/final_busdetails.csv")

# Clean up nulls if needed
df = df.fillna({
    "Bus_Name": "Not Available",
    "Bus_Type": "Not Available",
    "Duration": "0",
    "Star_Rating": 0,
    "Price": 0,
    "Seats_available": 0
})

# Convert datetime columns to string if needed
df['Departing_Time'] = pd.to_datetime(df['Departing_Time'], errors='coerce').dt.time
df['Reaching_Time'] = pd.to_datetime(df['Reaching_Time'], errors='coerce').dt.time

# Connect to MySQL
conn = mysql.connector.connect(
    host="localhost",
    user="your_username",
    password="your_password",
    database="your_database"
)
cursor = conn.cursor()

# Insert data into the table
insert_query = """
    INSERT INTO bus_details (
        Route_name, Route_link, Bus_Name, Bus_Type,
        Departing_Time, Duration, Reaching_Time,
        Star_Rating, Price, Seats_available
    ) VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s)
"""

for _, row in df.iterrows():
    cursor.execute(insert_query, (
        row['Route_name'],
        row['Route_link'],
        row['Bus_Name'],
        row['Bus_Type'],
        row['Departing_Time'],
        row['Duration'],
        row['Reaching_Time'],
        row['Star_Rating'],
        row['Price'],
        row['Seats_available']
    ))

conn.commit()
cursor.close()
conn.close()
