# Build the selenium script to loop through all routes
multi_route_script = 
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
import time
import pandas as pd

# Define routes
routes = [
    ("Delhi", "Lucknow"),
    ("Hyderabad", "Bangalore"),
    ("Madurai", "Chennai"),
    ("Mumbai", "Pune"),
    ("Chennai", "Bangalore"),
    ("Kolkata", "Patna"),
    ("Ahmedabad", "Surat"),
    ("Jaipur", "Delhi"),
    ("Indore", "Bhopal"),
    ("Goa", "Mumbai")
]

# Setup WebDriver
driver = webdriver.Chrome()
driver.maximize_window()

all_data = []

for src, dest in routes:
    try:
        driver.get("https://www.redbus.in")
        time.sleep(3)

        # Input source
        source = driver.find_element(By.ID, "src")
        source.clear()
        source.send_keys(src)
        time.sleep(1)
        source.send_keys(Keys.ENTER)

        # Input destination
        destination = driver.find_element(By.ID, "dest")
        destination.clear()
        destination.send_keys(dest)
        time.sleep(1)
        destination.send_keys(Keys.ENTER)

        # Pick a date
        driver.find_element(By.ID, "onward_cal").click()
        time.sleep(1)
        driver.find_element(By.CSS_SELECTOR, ".rb-calendar td.current.day").click()
        time.sleep(1)

        # Search
        driver.find_element(By.ID, "search_btn").click()
        time.sleep(10)

        # Extract results
        buses = driver.find_elements(By.XPATH, "//div[@class='travels lh-24 f-bold d-color']")

        for i in range(len(buses)):
            try:
                operator = driver.find_elements(By.XPATH, "//div[@class='travels lh-24 f-bold d-color']")[i].text
                dep_time = driver.find_elements(By.XPATH, "//div[@class='dp-time f-19 d-color f-bold']")[i].text
                arr_time = driver.find_elements(By.XPATH, "//div[@class='bp-time f-19 d-color disp-Inline']")[i].text
                duration = driver.find_elements(By.XPATH, "//div[@class='dur f-19 d-color f-bold']")[i].text
                price = driver.find_elements(By.XPATH, "//div[@class='fare d-block']/span")[i].text
                seat = driver.find_elements(By.XPATH, "//div[@class='seat-left m-top-16']")[i].text

                all_data.append({
                    'Source': src,
                    'Destination': dest,
                    'Operator': operator,
                    'Departure Time': dep_time,
                    'Arrival Time': arr_time,
                    'Duration': duration,
                    'Price': price,
                    'Seat Availability': seat
                })
            except:
                continue
    except Exception as e:
        print(f"Error scraping {src} to {dest}: {e}")
        continue

# Save to CSV
df = pd.DataFrame(all_data)
df.to_csv("redbus_data.csv", index=False)
print("Scraped data saved to redbus_data.csv")

# Quit browser
driver.quit()


# Save to a new file
multi_route_file_path = "/mnt/data/redbus_multi_route_scraper.py"
